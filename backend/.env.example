# GUIDE ME - Backend Configuration
PROJECT_NAME="GUIDE ME - FINAL"
ENVIRONMENT=development
DEBUG=True

# Security
SECRET_KEY=guideme-enterprise-super-secret-key-development-2026-replace-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/guideme_db
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/guideme_db
DATABASE_FALLBACK_SQLITE=True
DATABASE_SQLITE_URL=sqlite+aiosqlite:///./guideme_local.db
DATABASE_SQLITE_URL_SYNC=sqlite:///./guideme_local.db

# AI & LLM Provider Settings
# Options: gemini, mock, openai
AI_PROVIDER=gemini

# Google Gemini API (Server-Side Only - Never exposed to frontend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API (Optional Fallback)
OPENAI_API_KEY=
AI_MODEL_NAME=gpt-4o-mini

# Wearables Provider
WEARABLE_PROVIDER=mock
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=

# Privacy & Safety
PRIVACY_ALLOW_RAW_FACIAL_STORAGE=False
SAFETY_CRISIS_HOTLINE_DEFAULT=14416
SAFETY_CRISIS_INTERNATIONAL_INFO=https://findahelpline.com
