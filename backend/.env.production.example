# =====================================================================
# GUIDE ME - Production Backend Environment Configuration
# =====================================================================
# For deployment on Render, Railway, Fly.io, or VPS:
# Set these variables in your platform dashboard (Environment Variables).

PROJECT_NAME="GUIDE ME - FINAL"
VERSION="1.0.0"
ENVIRONMENT=production
DEBUG=False
API_V1_PREFIX=/api/v1

# ---------------------------------------------------------------------
# Security & JWT Tokens
# Generate a new random secret with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ---------------------------------------------------------------------
SECRET_KEY=REPLACE_WITH_A_SECURE_RANDOM_32_CHAR_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8

# ---------------------------------------------------------------------
# Production PostgreSQL Database (e.g. Neon.tech, Supabase, Render Postgres)
# Supports postgres://, postgresql://, or postgresql+asyncpg://
# In production, SQLite fallback is strictly disabled to protect data integrity.
# ---------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<PORT>/<DB_NAME>?sslmode=require
DATABASE_FALLBACK_SQLITE=False

# ---------------------------------------------------------------------
# CORS Allowed Origins
# Comma-separated list of your production frontend domains.
# Note: Vercel (*.vercel.app) and Render (*.onrender.com) domains are automatically permitted.
# ---------------------------------------------------------------------
CORS_ORIGINS=https://your-frontend.vercel.app,capacitor://localhost

# ---------------------------------------------------------------------
# AI Companion & Intelligence
# Get your free Gemini API key from https://aistudio.google.com
# ---------------------------------------------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-1.5-flash

# ---------------------------------------------------------------------
# Hardware & Wearables
# Default is 'mock' which generates realistic synthetic health biometrics.
# ---------------------------------------------------------------------
WEARABLE_PROVIDER=mock
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=

# ---------------------------------------------------------------------
# Privacy & Safety Guardrails
# ---------------------------------------------------------------------
PRIVACY_ALLOW_RAW_FACIAL_STORAGE=False
RATE_LIMIT_PER_MINUTE=120
SAFETY_CRISIS_HOTLINE_DEFAULT=14416
SAFETY_CRISIS_INTERNATIONAL_INFO=https://findahelpline.com
