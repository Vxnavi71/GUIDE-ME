# =====================================================================
# GUIDE ME - FINAL | Environment Configuration Template
# =====================================================================
# Copy this file to .env and adjust configurations as needed.
# NEVER commit the actual .env file or sensitive secrets to source control.

# Application Information
PROJECT_NAME="GUIDE ME - FINAL"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Security & Authentication
# Generate with: openssl rand -hex 32
SECRET_KEY="change-this-to-a-secure-32-byte-hex-key-in-production-guideme-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8

# Database Configuration
# PostgreSQL is the primary enterprise target.
# If PostgreSQL is not active locally, SQLite fallback will automatically initialize
# a local database (guideme_local.db) so you can run, develop, and test immediately.
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/guideme_db"
DATABASE_URL_SYNC="postgresql://postgres:postgres@localhost:5432/guideme_db"
DATABASE_FALLBACK_SQLITE=True
DATABASE_SQLITE_URL="sqlite+aiosqlite:///./guideme_local.db"
DATABASE_SQLITE_URL_SYNC="sqlite:///./guideme_local.db"

# Cross-Origin Resource Sharing (CORS)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# AI Companion Configuration
# Supported providers: "mock" (default clinical local heuristic), "openai"
AI_PROVIDER="mock"
AI_MODEL_NAME="gpt-4o-mini"
OPENAI_API_KEY=""

# Wearable Integrations
# Supported providers: "mock" (realistic physiological simulation), "fitbit", "apple_health", "google_fit"
WEARABLE_PROVIDER="mock"
FITBIT_CLIENT_ID=""
FITBIT_CLIENT_SECRET=""

# Digital Wellbeing & Privacy Controls
PRIVACY_ALLOW_RAW_FACIAL_STORAGE=False
PRIVACY_DEFAULT_ANONYMIZE_AUDIT=False

# Rate Limiting & Safety
RATE_LIMIT_PER_MINUTE=120
SAFETY_CRISIS_HOTLINE_DEFAULT="988"
SAFETY_CRISIS_INTERNATIONAL_INFO="https://findahelpline.com"
